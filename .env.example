# Application
APP_ENV=development
LOG_LEVEL=INFO
STORE_NAME=Example Store
STORE_CURRENCY=ZAR
API_BASE_URL=http://localhost:8000

# Database
# Set DATABASE_URL in production. Leave blank locally to use SQLite.
DATABASE_URL=
LOCAL_SQLITE_PATH=backend/data/app.db

# WhatsApp / Kapso
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v24.0
WHATSAPP_SEND_MODE=dry_run
WHATSAPP_GREETING_COMMANDS=hi,hello,hey,start, order, oder, perfume
WHATSAPP_CATALOG_COMMANDS=menu,catalogue,catalog,products
WHATSAPP_CHECKOUT_COMMANDS=done,checkout,order
WHATSAPP_CONFIRM_COMMANDS=yes,y,ok,correct
WHATSAPP_REJECT_COMMANDS=no,n
WHATSAPP_CANCEL_COMMANDS=cancel,stop
POP_EXPIRY_HOURS=24
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,zu
SHIPPING_FEE=65.00
FREE_SHIPPING_THRESHOLD=2000.00

# Admin / operations
DASHBOARD_API_KEY=
ADMIN_PHONE=
MANUFACTURER_PHONE=

# Frontend / deployment
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SENTRY_DSN=
